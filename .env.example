# Copy to .env to override defaults (never commit .env).
# All EchoTwin state lives under ECHOTWIN_HOME (private by default).

ECHOTWIN_HOME=
ECHOTWIN_MAX_UPLOAD_MB=50
ECHOTWIN_API_HOST=127.0.0.1
ECHOTWIN_API_PORT=8765
ECHOTWIN_UI_HOST=127.0.0.1
ECHOTWIN_UI_PORT=7860
ECHOTWIN_REDACT_PII=false
ECHOTWIN_LANGUAGE_DETECTOR=heuristic
