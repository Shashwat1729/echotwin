# Benchmark outputs (measured locally, never committed)
benchmarks/results.json
benchmarks/_tmp/

# Fetched open speech samples (reproducible via scripts/fetch_sample_audio.py)
# The audio itself is NOT committed (third-party licenses vary); the provenance
# manifests are, so the evaluation set stays reproducible and attributable.
sample_audio/**
!sample_audio/manifest.json
!sample_audio/hi-speakers/
!sample_audio/hi-speakers/manifest.json
sample_audio/**/*.wav
sample_audio/**/*.parquet
sample_audio/**/*.flac
sample_audio/**/*.mp3
sample_audio/**/*.ogg

# Fetched public text corpus (reproducible via scripts/fetch_public_corpus.py).
# Like sample_audio/, the data itself is NOT committed; the fetch script and
# the provenance in docs/results.md keep it reproducible and attributable.
sample_corpus/

# Notebook checkpoints
.ipynb_checkpoints/

