{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EchoTwin benchmark results",
  "type": "object",
  "required": ["dataset", "baseline_mock", "audio_quality", "synthesis"],
  "properties": {
    "dataset": {
      "type": "object",
      "required": ["messages", "examples", "seconds"],
      "properties": {
        "messages": { "type": "integer" },
        "examples": { "type": "integer" },
        "seconds": { "type": "number" },
        "examples_per_second": { "type": ["number", "null"] }
      }
    },
    "baseline_mock": {
      "type": "object",
      "required": ["prompts", "seconds"],
      "properties": {
        "prompts": { "type": "integer" },
        "seconds": { "type": "number" },
        "ms_per_prompt": { "type": ["number", "null"] }
      }
    },
    "audio_quality": {
      "type": "object",
      "required": ["seconds_5s_clip", "verdict"],
      "properties": {
        "seconds_5s_clip": { "type": "number" },
        "verdict": { "type": "string" }
      }
    },
    "synthesis": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
